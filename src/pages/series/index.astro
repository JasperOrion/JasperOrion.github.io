---
import BaseLayout from '../../layouts/BaseLayout.astro'; import EmptyState from '../../components/EmptyState.astro'; import { counts,getArticles } from '../../utils/content'; const items=counts(await getArticles(),a=>a.data.series);
---
<BaseLayout title="系列"><div class="container page"><h1>系列</h1>{items.length?<div class="grid">{items.map(([v,n])=><a class="card" href={`/series/${encodeURIComponent(v)}/`}><strong>{v}</strong><br/>{n} 篇</a>)}</div>:<EmptyState/>}</div></BaseLayout>
