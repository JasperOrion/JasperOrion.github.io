---
import BaseLayout from '../layouts/BaseLayout.astro'; import ArticleCard from '../components/ArticleCard.astro'; import EmptyState from '../components/EmptyState.astro'; import { SITE, typeLabel } from '../config'; import { counts, getArticles } from '../utils/content'; import { routePart } from '../utils/tags';
const articles = await getArticles(); const domains = counts(articles, a => a.data.domain); const types = counts(articles, a => a.data.type); const tags = [...new Set(articles.flatMap(a => a.data.tags))].slice(0,12); const series = counts(articles, a => a.data.series);
---
<BaseLayout><section class="hero"><div class="container"><p class="eyebrow">Computer Science · Learning Notes</p><h1>让学习留下<br/>可连接的轨迹。</h1><p class="lede">{SITE.intro[0]}<br/>{SITE.intro[1]}</p></div></section>
<section class="section"><div class="container"><div class="section-head"><h2>学习领域</h2><a href="/topics/">查看全部</a></div>{domains.length ? <div class="grid">{domains.slice(0,6).map(([v,n]) => <a class="card" href={`/topics/${encodeURIComponent(v)}/`}><strong>{v}</strong><br/><span>{n} 篇内容</span></a>)}</div> : <EmptyState>公开内容尚未同步，领域会在文章发布后自动生成。</EmptyState>}</div></section>
<section class="section"><div class="container"><div class="section-head"><h2>精选内容</h2><a href="/articles/">全部文章</a></div><div class="grid">{articles.filter(a=>a.data.featured).slice(0,3).map(a=><ArticleCard article={a}/>)}</div>{!articles.some(a=>a.data.featured)&&<EmptyState>目前没有精选内容。</EmptyState>}</div></section>
<section class="section"><div class="container"><div class="section-head"><h2>最近更新</h2></div><div class="grid">{articles.slice(0,3).map(a=><ArticleCard article={a}/>)}</div>{!articles.length&&<EmptyState>正式内容源当前为空，测试内容不会进入公开站点。</EmptyState>}</div></section>
<section class="section"><div class="container grid"><div class="card"><h2>内容类型</h2>{types.length ? types.map(([v,n])=><p><a href={`/types/${encodeURIComponent(v)}/`}>{typeLabel(v)}</a> · {n}</p>):<p>暂无分类</p>}</div><div class="card"><h2>常用标签</h2>{tags.length ? tags.map(v=><a class="pill" href={`/tags/${routePart(v)}/`}>{v}</a>):<p>暂无标签</p>}</div><div class="card"><h2>最近系列</h2>{series.length ? series.slice(0,5).map(([v,n])=><p><a href={`/series/${encodeURIComponent(v)}/`}>{v}</a> · {n}</p>):<p>暂无系列</p>}</div></div></section>
<section class="section"><div class="container card"><h2>在 GitHub 上关注更新</h2><p>查看博客代码、构建方式与公开内容变更。</p><a href={SITE.github}>访问 Jasper 的 GitHub</a></div></section></BaseLayout>
