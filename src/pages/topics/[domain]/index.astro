---
import ListLayout from '../../../layouts/ListLayout.astro'; import { getArticles } from '../../../utils/content';
export async function getStaticPaths(){const all=await getArticles();return [...new Set(all.map(a=>a.data.domain))].map(domain=>({params:{domain},props:{domain,articles:all.filter(a=>a.data.domain===domain)}}))} const {domain,articles}=Astro.props;
---
<ListLayout title={domain} articles={articles}/>
