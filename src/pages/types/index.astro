---
import BaseLayout from '../../layouts/BaseLayout.astro'; import EmptyState from '../../components/EmptyState.astro'; import { typeLabel } from '../../config'; import { counts,getArticles } from '../../utils/content'; const items=counts(await getArticles(),a=>a.data.type);
---
<BaseLayout title="内容类型"><div class="container page"><h1>内容类型</h1>{items.length?<div class="grid">{items.map(([v,n])=><a class="card" href={`/types/${encodeURIComponent(v)}/`}><strong>{typeLabel(v)}</strong><br/>{n} 篇</a>)}</div>:<EmptyState/>}</div></BaseLayout>
