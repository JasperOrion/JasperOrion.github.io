---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getArticles } from '../../utils/content'; import { formatDate } from '../../utils/date'; import { neighbors } from '../../utils/navigation'; import { absoluteUrl, articleUrl } from '../../utils/url'; import { routePart } from '../../utils/tags'; import { render } from 'astro:content'; import { typeLabel } from '../../config';
export async function getStaticPaths(){return (await getArticles()).map(article=>({params:{slug:article.data.slug},props:{article}}))}
const {article}=Astro.props; const all=await getArticles(); const {Content,headings}=await render(article); const nav=neighbors(all,article.data.slug);
const jsonLd={'@context':'https://schema.org','@type':'TechArticle',headline:article.data.title,description:article.data.description,datePublished:article.data.created.toISOString(),dateModified:article.data.updated.toISOString(),author:{'@type':'Person',name:'Jasper'},url:absoluteUrl(articleUrl(article.data.slug))};
---
<BaseLayout title={article.data.title} description={article.data.description} type="article" published={article.data.created.toISOString()} modified={article.data.updated.toISOString()} tags={article.data.tags} jsonLd={jsonLd}><div class="article-shell"><article class="prose" data-pagefind-body><nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a> / <a href="/articles/">文章</a> / {article.data.title}</nav><h1 data-pagefind-meta="title">{article.data.title}</h1><p class="lede">{article.data.description}</p><div class="meta"><span>{typeLabel(article.data.type)}</span><span>{article.data.domain}</span><span>创建 {formatDate(article.data.created)}</span><span>更新 {formatDate(article.data.updated)}</span></div><p>{article.data.tags.map((tag:string)=><a class="pill" href={`/tags/${routePart(tag)}/`}>{tag}</a>)}</p><Content/><nav class="pager" aria-label="文章导航">{nav.previous?<a href={articleUrl(nav.previous.data.slug)}>← {nav.previous.data.title}</a>:<span/>}{nav.next?<a href={articleUrl(nav.next.data.slug)}>{nav.next.data.title} →</a>:<span/>}</nav><p><a href="/articles/">← 返回全部内容</a></p></article>{headings.filter(h=>h.depth===2||h.depth===3).length>0&&<aside class="toc"><strong>目录</strong><ol>{headings.filter(h=>h.depth===2||h.depth===3).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></aside>}</div></BaseLayout>
